{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/tools/fhir-validator/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/tools/fhir-validator/",
      "destination": "/index.html"
    },
    {
      "source": "/tools/fhir-validator/how-to-use/",
      "destination": "/how-to-use/index.html"
    },
    {
      "source": "/tools/fhir-validator/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
